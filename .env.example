# Deployer (TESTNET ONLY — never a real-funds key)
PRIVATE_KEY=0x...

# RPCs (use a private/paid endpoint for mainnet; public ones rate-limit)
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_MAINNET_RPC_URL=

# Explorer verification
BSCSCAN_API_KEY=

# Randomness provider: "mock" or "chainlink"
RANDOMNESS_PROVIDER=chainlink

# Chainlink VRF v2.5 — BNB Chain Testnet (chainId 97), 50 gwei gas lane
# Verified against https://docs.chain.link/vrf/v2-5/supported-networks
VRF_COORDINATOR=0xDA3b641D438362C440Ac5458c57e00a712b66700
VRF_KEY_HASH=0x8596b430971ac45bdf6088665b9ad8e8630c9d5049ab54b14dff711bee7c0e26
VRF_SUBSCRIPTION_ID=
VRF_CALLBACK_GAS_LIMIT=300000
VRF_REQUEST_CONFIRMATIONS=3
VRF_PAY_IN_NATIVE=true

# Deployed CandleAuctionHouse (BNB testnet, from docs/devnet-run.md) — used by crank + app
AUCTION_HOUSE=0x662Fe2bC63A414a020B20a7835832eaeBc594881
# Optional separate key for the crank (falls back to PRIVATE_KEY)
CRANK_PRIVATE_KEY=
