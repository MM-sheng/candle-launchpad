# 97 = testnet; 56 = mainnet. Mainnet requires an explicit RPC and house address.
NEXT_PUBLIC_CHAIN_ID=97
# Testnet only: MockERC20 with public mint(), used by the onboarding "mint test tokens" button
NEXT_PUBLIC_TEST_TOKEN=0xcb415e4C71df31128f5597Ad067355396D343c9a
NEXT_PUBLIC_AUCTION_HOUSE=0x662Fe2bC63A414a020B20a7835832eaeBc594881
# Comma-separated; first is primary, others are fallbacks
NEXT_PUBLIC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545,https://bsc-testnet-rpc.publicnode.com
# WalletConnect Cloud project id (free): https://cloud.walletconnect.com — optional, injected wallets work without it
NEXT_PUBLIC_WC_PROJECT_ID=
