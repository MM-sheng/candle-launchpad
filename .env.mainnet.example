# Copy to .env.mainnet locally; never commit secrets. Do not reuse testnet keys.
# Deploy.s.sol reads PRIVATE_KEY. Wallet setup/signing is performed by the user.
CHAIN_ID=56
PRIVATE_KEY=
BSC_MAINNET_RPC_URL=
BSCSCAN_API_KEY=
RANDOMNESS_PROVIDER=chainlink
# Verify these against current Chainlink BNB mainnet documentation before deployment.
VRF_COORDINATOR=
VRF_KEY_HASH=
VRF_SUBSCRIPTION_ID=
VRF_CALLBACK_GAS_LIMIT=300000
VRF_REQUEST_CONFIRMATIONS=3
VRF_PAY_IN_NATIVE=true
SAFE_ADDRESS=
